{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-mail",
  "account_id": "5f0f967f8a7514a497861b1e1f7147e5",
  "main": "src/index.js",
  "compatibility_date": "2025-06-04",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mail.newstardev.me", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "email",
      "database_id": "cd6c9349-b289-4d7f-81e5-9b03bfd60e03"
    }
  ],
  "kv_namespaces": [
    { "binding": "kv", "id": "85924da7d5e8464a9eb949b3fd534545" }
  ],
  "ai": { "binding": "ai" },
  "assets": {
    "binding": "assets",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    }
  },
  "build": { "command": "pnpm --prefix ../mail-vue install --frozen-lockfile && pnpm --prefix ../mail-vue run build" }
}
